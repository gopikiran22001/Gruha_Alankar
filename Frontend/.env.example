# Gruha Alankara — Frontend Environment Variables
# Copy this file to .env and fill in your values.

# ── Backend API ──
# Base URL for the Flask backend API.
# In development the Vite proxy rewrites /api → http://localhost:5000, so /api is correct.
# For production point this at your deployed backend, e.g. https://api.yourapp.com/api
VITE_API_BASE_URL=/api

# ── Firebase (optional) ──
# Leave blank to use the Flask/JWT backend for authentication.
# Fill these in only if you want to add Firebase Auth (Google sign-in, etc.)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-app-id
